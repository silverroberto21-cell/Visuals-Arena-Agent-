# Modèle vide des secrets — copier en .env (ignoré par Git) et remplir sur le poste.
# Ne JAMAIS committer de valeur réelle ici. Voir specs/cles-api.md.
# Aucune de ces variables n'est requise pour les visuels composés en local
# (texte en couche de design, détourage manuel, upscale Lanczos).

# Modèles image / édition (Qwen-Image, Qwen-Image-Edit, FLUX.2 klein, Z-Image…) via un service
IMAGE_API_BASE=
IMAGE_API_KEY=

# Modèle haut de gamme "fonds et effets" (si un compte payant est utilisé)
PREMIUM_IMAGE_API_BASE=
PREMIUM_IMAGE_API_KEY=

# Upscaler IA (facultatif : repli Lanczos si absent)
UPSCALER_API_BASE=
UPSCALER_API_KEY=
